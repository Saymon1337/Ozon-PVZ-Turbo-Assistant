{
  "manifest_version": 3,
  "name": "Ozon PVZ: Turbo Assistant (Защита сканера + Оповещение об отправке)",
  "version": "2.0.0",
  "description": "Комплексный помощник для сотрудников Турбо ПВЗ Ozon: блокировка сбоев сканера («Честный Знак») и умные оповещения об отправке товаров.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://turbo-pvz.ozon.ru/*",
    "*://*.turbo-pvz.ozon.ru/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://turbo-pvz.ozon.ru/*",
        "*://*.turbo-pvz.ozon.ru/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
